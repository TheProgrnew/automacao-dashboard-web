# Configuração FICTÍCIA para execução LOCAL. Não contém credenciais reais.
# Copie este arquivo para .env. Nunca publique seu .env.
DJANGO_SECRET_KEY=dev-only-placeholder-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_TIME_ZONE=America/Sao_Paulo
# 1: TESTE_AUTOMACAO. 0: caminhos configurados em DEMO_CONFIGURADA.
# Ambos usam dados fictícios. A origem do e-mail é escolhida separadamente.
AUTOMACAO_MODO_TESTE=1
# Principal: win32com (Windows + Excel). Alternativa: openpyxl.
AUTOMACAO_MOTOR=win32com
DJANGO_DEPLOYMENT_MODE=0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Portfolio Demo <demo@example.invalid>

# Origem dos relatórios: local (padrão, sem e-mail) ou gmail (opcional).
AUTOMACAO_ORIGEM=local

# Preencha APENAS sua .env para habilitar Gmail. Não edite este exemplo com segredos.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USUARIO=
# Senha de APP de 16 caracteres, gerada pelo Google; não é sua senha normal.
EMAIL_SENHA_APP=
# Em branco: aceita o próprio EMAIL_USUARIO como remetente.
EMAIL_REMETENTE=
EMAIL_ASSUNTO=PORTFOLIO_DASHBOARD_DEMO

# Conta LOCAL do Dashboard. É diferente da conta/senha de acesso ao Gmail.
# Usada somente quando você executar: python manage.py criar_admin_env
DASHBOARD_ADMIN_USUARIO=admin_demo
DASHBOARD_ADMIN_EMAIL=admin@example.invalid
DASHBOARD_ADMIN_SENHA=
